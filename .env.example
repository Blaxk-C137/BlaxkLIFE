# BLXVERSE configuration (placeholders only - never commit real values)
# Set these in your shell or hosting environment; .env is not loaded automatically.

# HTTP server
BLXVERSE_HOST=0.0.0.0
# Render supplies PORT automatically. Do not set BLXVERSE_PORT there.
BLXVERSE_PORT=8000
BLXVERSE_DATA_DIR=data
# On Render with the Blueprint disk: /var/data/blxverse
# Optional browser login (username is blxverse); use HTTPS on public hosts.
# BLXVERSE_ACCESS_PASSWORD=use-a-long-random-password

# World defaults
BLXVERSE_WORLD_SEED=20261017

# Gemini dialogue for in-person chats, texts and calls. Server-side only.
# GEMINI_API_KEY=replace-me
# GEMINI_MODEL=gemini-3.5-flash-lite
# GOOGLE_API_KEY is also accepted. Restart the server after changing env.
# Process-local guardrails; NOT Google account quotas or a free-billing guarantee.
# GEMINI_LOCAL_RPM=8
# GEMINI_LOCAL_RPD=150
# Existing OpenAI-compatible configuration remains supported as a fallback provider.
# Optional selective LLM phrasing (OpenAI-compatible endpoint).
# The game is fully playable without it; the deterministic composer is default.
# The model may only rephrase a line — it can never change game state.
# BLXVERSE_LLM_BASE_URL=https://api.openai.com/v1
# BLXVERSE_LLM_API_KEY=replace-me
# BLXVERSE_LLM_MODEL=gpt-4o-mini
# BLXVERSE_LLM_DISABLED=1        # force deterministic mode even if a key is set

# Debug: log one line per HTTP request
# BLXVERSE_HTTP_LOG=1

# Voice: this slice uses the browser's speech APIs (which may use vendor cloud services).
# No audio is uploaded or retained by the server.
# BLXVERSE_VOICE_ENABLED=true
